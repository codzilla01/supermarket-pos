# FreshMart POS — environment configuration
# Copy these into the environment of your process manager.

PORT=3000
HOST=0.0.0.0
POS_DB_PATH=./pos.db

# Required startup secrets: use unique random values of at least 16 characters.
# The initial admin password is used only when creating a fresh database.
POS_INITIAL_ADMIN_PASSWORD=
POS_DEVELOPER_USERNAME=
POS_DEVELOPER_PASSWORD=

# Host port used by docker-compose (the container always listens on 3000).
POS_PORT=3000

# Session cookies are Secure by default. Set false only for local plain-HTTP development.
POS_COOKIE_SECURE=true
# Set to none only when the POS is embedded in a third-party iframe (needs HTTPS).
POS_COOKIE_SAMESITE=lax
# true also returns the session token so clients can send "Authorization: Bearer …"
# (needed when the browser blocks cookies, e.g. embedded previews).
POS_TOKEN_AUTH=false

# Optional, only for refunds of historical card sales; checkout accepts cash only.
STRIPE_SECRET_KEY=

# Automatic gzipped JSON backups (products, sales, shifts, settings, audit log).
POS_BACKUP_ENABLED=true
POS_BACKUP_DIR=./backups
POS_BACKUP_INTERVAL_HOURS=24
POS_BACKUP_KEEP=7

# Encrypted off-site copy (AES-256-GCM .posbak pushed to an external endpoint).
# Leave empty to keep backups local only. Keys/tokens must never be committed.
POS_BACKUP_ENCRYPTION_KEY=
POS_BACKUP_UPLOAD_URL=
POS_BACKUP_UPLOAD_TOKEN=
POS_BACKUP_UPLOAD_METHOD=PUT

# Logging: json = one object per line for log shippers; levels: debug|info|warn|error.
POS_LOG_FORMAT=text
POS_LOG_LEVEL=info
