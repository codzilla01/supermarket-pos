# FreshMart POS — environment configuration
# Copy to your shell / process manager. All values are optional.

PORT=3000
HOST=0.0.0.0

# Path to the SQLite database file (created automatically on first run)
POS_DB_PATH=./pos.db

# Session cookies are Secure by default. Set false only for local plain-HTTP development.
POS_COOKIE_SECURE=true

# Stripe card payments (optional — without these, card payments are simulated)
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
