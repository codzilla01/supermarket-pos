# FreshMart POS — environment configuration
# Copy these into the environment of your process manager.

PORT=3000
HOST=0.0.0.0
POS_DB_PATH=./pos.db

# Session cookies are Secure by default. Set false only for local plain-HTTP development.
POS_COOKIE_SECURE=true

# Optional, only for refunds of historical card sales; checkout accepts cash only.
STRIPE_SECRET_KEY=
